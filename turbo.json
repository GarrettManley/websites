{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["content/**"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["build", "^build"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^build", "build"] },
    "verify": { "dependsOn": ["build"] },
    "e2e": { "dependsOn": ["build"] },
    "deploy": { "dependsOn": ["verify"], "cache": false, "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "PR_NUMBER"] },
    "preview": { "dependsOn": ["verify"], "cache": false, "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "PR_NUMBER"] }
  }
}
