{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": {},
    "lint": {},
    "typecheck": {},
    "verify": { "dependsOn": ["build"] },
    "e2e": { "dependsOn": ["build"] },
    "deploy": { "dependsOn": ["verify"], "cache": false },
    "preview": { "dependsOn": ["verify"], "cache": false }
  }
}
