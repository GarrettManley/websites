---
/** Wraps rendered Markdown/MDX and restores the flow that Tailwind preflight resets. */
---

<div class="prose"><slot /></div>

<style>
  .prose :global(:where(p, ul, ol, pre, blockquote, figure) + *) {
    margin-top: var(--space-4);
  }
  .prose :global(:where(h2, h3) + *) {
    margin-top: var(--space-3);
  }
  /*
   * Headings take the type scale's size and leading (text-h3 and text-h4). An h2 opens a section:
   * the space above it is larger than any space inside one.
   */
  .prose :global(h2) {
    margin-top: var(--space-12);
    font-size: 1.375rem;
    line-height: 1.364;
    font-weight: 600;
    text-wrap: balance;
  }
  .prose :global(h3) {
    margin-top: var(--space-6);
    font-size: 1.125rem;
    line-height: 1.444;
    font-weight: 600;
    text-wrap: balance;
  }
  @media (width >= 64rem) {
    .prose :global(h2) {
      margin-top: var(--space-16);
    }
  }
  /* Dates are set in mono and never break at a hyphen. */
  .prose :global(time) {
    font-family: var(--font-mono);
    font-size: 0.9375em;
    white-space: nowrap;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: var(--space-6);
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: var(--space-6);
  }
  .prose :global(:where(code, pre)) {
    font-family: var(--font-mono);
  }
  .prose :global(pre) {
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    padding: var(--space-4);
    border-radius: var(--radius);
    border: var(--stroke-hair) solid var(--color-border);
  }
  .prose :global(:where(details) + *) {
    margin-top: var(--space-4);
  }
  .prose :global(:where(table)) {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
  }
  .prose :global(:where(th)) {
    text-align: left;
    font-weight: 500;
  }
  .prose :global(:where(th, td)) {
    vertical-align: top;
    padding: var(--space-2) var(--space-3);
  }
  .prose :global(:where(tbody tr)) {
    border-top: var(--stroke-hair) solid var(--color-border);
  }
  .prose :global(:where(table code)) {
    overflow-wrap: anywhere;
  }
</style>
