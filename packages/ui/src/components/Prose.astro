---
/** Wraps rendered Markdown/MDX and restores the flow that Tailwind preflight resets. */
---

<div class="prose"><slot /></div>

<style>
  .prose :global(:where(p, ul, ol, pre, blockquote, figure) + *) {
    margin-top: var(--space-4);
  }
  .prose :global(:where(h2, h3) + *) {
    margin-top: var(--space-3);
  }
  .prose :global(h2) {
    margin-top: var(--space-8);
    font-size: 1.375rem;
    font-weight: 600;
  }
  .prose :global(h3) {
    margin-top: var(--space-6);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: var(--space-6);
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: var(--space-6);
  }
  .prose :global(:where(code, pre)) {
    font-family: var(--font-mono);
  }
  .prose :global(pre) {
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    padding: var(--space-4);
    border-radius: var(--radius);
    border: var(--stroke-hair) solid var(--color-border);
  }
</style>
