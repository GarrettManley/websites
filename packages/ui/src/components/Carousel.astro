---
import { neighbourSlide } from "@gm/core";
import type { ImageMetadata } from "astro";

/**
 * Images shown one at a time, stepped with Previous and Next. No script: each slide follows a
 * radio input and is shown while that input is checked, and the two controls are labels for the
 * neighbouring inputs. The arrow keys therefore work as they do in any radio group.
 */
interface Slide {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  /** Unique on the page: it names the radio group and prefixes the element ids. */
  id: string;
  /** Names the group for assistive technology, e.g. "Overlay screenshots". */
  label: string;
  /** Use images of one size, so the frame keeps its height from slide to slide. */
  slides: Slide[];
}

const { id, label, slides } = Astro.props;
/* MDX passes props unchecked; a slide without an image or alt text would ship broken. */
const problems = [
  !id && "id is missing",
  !label && "label is missing",
  (!slides || slides.length === 0) && "slides is empty",
  ...(slides ?? []).map(
    (slide, index) =>
      !(typeof slide.image?.src === "string" && slide.alt?.trim() && slide.caption?.trim()) &&
      `slide ${index + 1} needs an imported image, alt text and a caption`,
  ),
].filter(Boolean);
if (problems.length > 0) {
  throw new Error(`Carousel "${label || id || "?"}": ${problems.join("; ")}`);
}
const count = slides.length;
const stepped = count > 1;
---

<div class="carousel">
  <fieldset
    class:list={["frame rounded-lg border border-border bg-surface p-2 sm:p-4", { single: !stepped }]}
  >
    <legend class="sr-only">{label}</legend>
    {
      slides.map((slide, index) => (
        <>
          {stepped && (
            <input
              class="sr-only"
              type="radio"
              name={id}
              id={`${id}-${index + 1}`}
              checked={index === 0}
              aria-label={`Image ${index + 1} of ${count}`}
              aria-describedby={`${id}-caption-${index + 1}`}
            />
          )}
          <div class="slide">
            {stepped && (
              <div class="controls flex items-center justify-between">
                <label for={`${id}-${neighbourSlide(index, -1, count) + 1}`}>Previous</label>
                <span class="font-mono text-sm tabular-nums text-muted">
                  {index + 1} / {count}
                </span>
                <label for={`${id}-${neighbourSlide(index, 1, count) + 1}`}>Next</label>
              </div>
            )}
            <img
              class="mx-auto block h-auto max-w-full rounded-md"
              src={slide.image.src}
              width={slide.image.width}
              height={slide.image.height}
              alt={slide.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            <p class="caption text-sm text-muted" id={`${id}-caption-${index + 1}`}>
              {slide.caption} <a href={slide.image.src}>Full size</a>
            </p>
          </div>
        </>
      ))
    }
  </fieldset>
</div>

<style>
  /* Own the vertical rhythm inside Prose, whose unlayered rules would override utilities. */
  div.carousel {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
  fieldset.frame {
    position: relative;
    min-width: 0;
    margin: 0;
  }
  /*
   * The hidden inputs sit in the controls row at the top of the frame, so focusing one (by Tab
   * or through its label) never scrolls the page away from the controls that show its ring.
   */
  .carousel input {
    top: var(--space-6);
    left: 50%;
  }
  .carousel .slide {
    display: none;
  }
  .carousel input:checked + .slide,
  .carousel .single .slide {
    display: block;
  }
  .carousel .controls {
    margin-bottom: var(--space-2);
  }
  .carousel label {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-accent);
    cursor: pointer;
  }
  .carousel label:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* The inputs are visually hidden, so the controls carry the focus ring for them. */
  .carousel input:focus-visible + .slide .controls {
    outline: var(--stroke-mark) solid var(--color-focus-ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .carousel p.caption {
    margin: var(--space-2) 0 0;
  }
</style>
