---
import type { StackRow } from "@gm/core";
import Disclosure from "./Disclosure.astro";

interface Props {
  /** Frontmatter `stackDetail`. MDX passes it unchecked, so an absent list arrives as undefined. */
  rows: StackRow[];
  /** One sentence printed under the main table. */
  caption: string;
  /** Names the closed set of supporting rows; the row count is appended in the summary. */
  moreLabel?: string;
}

const { rows, caption, moreLabel = "Supporting libraries and tools" } = Astro.props;
/* A page without its rows would otherwise ship an empty table; fail the build instead. */
if (!rows || rows.length === 0) {
  throw new Error('TechTable needs a non-empty "rows" list (frontmatter "stackDetail")');
}
const primary = rows.filter((row) => row.tier === "primary");
const supporting = rows.filter((row) => row.tier === "supporting");
/* The supporting table takes the label as its caption, which tells the two tables apart. */
const tables = [
  { title: "Technology stack by layer", rows: primary, closed: false },
  ...(supporting.length > 0 ? [{ title: moreLabel, rows: supporting, closed: true }] : []),
];
/** One group per layer, in the order the layers first appear. */
const byLayer = (tierRows: StackRow[]) => [...Map.groupBy(tierRows, (row) => row.layer)];
/** A version may list several tokens ("1.0.229, 1.0.154"); each keeps its comma. */
const tokens = (version: string) => version.split(/(?<=,) /);
---

<div class="tech">
  {
    tables.map(({ title, rows: tierRows, closed }) => {
      const table = (
        <table class="tech-table text-sm">
          <caption class="sr-only">{title}</caption>
          <thead class="sr-only">
            <tr>
              <th scope="col">Technology and version</th>
              <th scope="col">Role and reason</th>
            </tr>
          </thead>
          {byLayer(tierRows).map(([layer, layerRows]) => (
            <tbody>
              <tr class="layer">
                <th class="font-mono text-eyebrow uppercase text-muted" colspan="2" scope="rowgroup">
                  {layer}
                </th>
              </tr>
              {layerRows.map((row) => (
                <tr>
                  <th scope="row">
                    {row.tech}
                    {row.version && (
                      <>
                        {" "}
                        <span class="version font-mono text-xs tabular-nums text-muted">
                          {tokens(row.version).map((token, index) => (
                            <>
                              {index > 0 && " "}
                              <span class="token">{token}</span>
                            </>
                          ))}
                        </span>
                      </>
                    )}
                  </th>
                  <td>
                    <span class="role">{row.role}</span>
                    {row.why && (
                      <>
                        {" "}
                        <span class="why text-muted">
                          <span class="why-label font-mono text-eyebrow uppercase">Why</span>{" "}
                          {row.why}
                        </span>
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      );
      return closed ? (
        <Disclosure summary={`${title} (${tierRows.length})`}>{table}</Disclosure>
      ) : (
        <>
          {table}
          <p class="tech-caption text-sm text-muted">{caption}</p>
        </>
      );
    })
  }
</div>

<style>
  /*
   * The block's distance from what precedes it is Prose's own flow rule, and Disclosure sets its
   * own; only the rhythm inside the block is set here.
   *
   * Two real columns at every width. Layout stays automatic: column 1 is 7.5rem and column 2 takes
   * the rest, and a token too long for column 1 widens it instead of running under column 2.
   */
  .tech-table {
    width: 100%;
  }
  .tech-table tbody th,
  .tech-table td {
    padding-block: var(--space-3);
    border-top: var(--stroke-hair) solid var(--color-border);
    text-align: start;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .tech-table th[scope="row"] {
    width: 7.5rem;
    padding-inline-end: var(--space-3);
    font-weight: 500;
  }
  .tech-table .layer th {
    padding-block: var(--space-4) var(--space-2);
  }
  .version {
    display: block;
    margin-top: var(--space-1);
    font-weight: 400;
  }
  /* A version wraps between tokens, never inside one. */
  .token {
    white-space: nowrap;
  }
  .role,
  .why {
    display: block;
  }
  .why {
    margin-top: var(--space-1);
  }
  .tech-caption {
    margin-top: var(--space-3);
  }
</style>
