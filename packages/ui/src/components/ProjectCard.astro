---
import type { ProjectSummary } from "@gm/core";
import TagList from "./TagList.astro";

interface Props {
  project: ProjectSummary;
}

const { project } = Astro.props;
---

<article class="rounded-[var(--radius)] border border-border bg-surface p-6">
  <h3 class="text-lg font-semibold"><a href={project.href}>{project.name}</a></h3>
  <p class="mt-2">{project.summary}</p>
  <div class="mt-3"><TagList tags={project.tags} /></div>
</article>
