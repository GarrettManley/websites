---
import type { Project } from "@gm/core";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="rounded-[var(--radius)] border border-border bg-surface p-6">
  <h3 class="text-lg font-semibold"><a href={project.url}>{project.name}</a></h3>
  <p class="mt-2">{project.summary}</p>
  <ul class="mt-3 flex flex-wrap gap-2 text-sm text-muted" aria-label="Tags">
    {project.tags.map((tag) => <li class="font-mono">{tag}</li>)}
  </ul>
</article>
