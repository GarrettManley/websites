---
interface Props {
  /** 1-based position in the case study; rendered as a two-digit prefix. */
  n: number;
  title: string;
}

const { n, title } = Astro.props;
/* A mistyped slot name would otherwise ship an empty row; fail the build instead. */
const missing = ["chose", "why", "proof"].filter((name) => !Astro.slots.has(name));
if (missing.length > 0) {
  throw new Error(`Decision ${n} "${title}" is missing required slot(s): ${missing.join(", ")}`);
}
const number = String(n).padStart(2, "0");
const label = "font-mono text-eyebrow uppercase text-muted";
/* Stacked below lg; from lg the label hangs in the margin left of the prose column. */
const row =
  "border-t border-border py-4 lg:grid lg:grid-cols-[7rem_minmax(0,1fr)] lg:items-baseline lg:gap-x-6";
const content = "mt-1 min-w-0 lg:mt-0";
---

<section class="decision">
  <h3 class="text-h4">
    <span class="mr-2 font-mono font-medium tabular-nums text-muted">{number}</span>{title}
  </h3>
  <dl class="border-b border-border lg:-ml-[calc(7rem+var(--space-6))]">
    <div class={row}>
      <dt class={label}>Chose</dt>
      <dd class={content}><slot name="chose" /></dd>
    </div>
    <div class={row}>
      <dt class={label}>Why</dt>
      <dd class={content}><slot name="why" /></dd>
    </div>
    {
      Astro.slots.has("rejected") && (
        <div class={row}>
          <dt class={label}>Rejected</dt>
          <dd class={content}>
            <slot name="rejected" />
          </dd>
        </div>
      )
    }
    <div class={row}>
      <dt class={label}>Proof</dt>
      <dd class={content}><slot name="proof" /></dd>
    </div>
  </dl>
</section>

<style>
  /* Own the vertical rhythm inside Prose, whose unlayered rules would override utilities. */
  section.decision {
    margin-top: var(--space-8);
  }
  .decision h3 {
    margin-top: 0;
  }
  .decision dl {
    margin-top: var(--space-4);
  }
</style>
