---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="measure-wide">
  <div
    class="overflow-x-auto rounded-lg border border-border bg-surface p-4 sm:p-6 [&>svg]:mx-auto [&>svg]:h-auto [&>svg]:max-w-full"
  >
    <slot />
  </div>
  <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>
</figure>
