---
import type { Metric } from "@gm/core";

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<dl class="measure-wide grid grid-cols-2 items-start gap-6 border-y border-border py-6 sm:grid-flow-col sm:auto-cols-fr">
  {
    metrics.map((metric) => (
      <div class="flex flex-col-reverse gap-1">
        <dt class="text-sm text-muted">{metric.label}</dt>
        <dd class="font-mono text-h3 font-medium tabular-nums text-fg">{metric.value}</dd>
      </div>
    ))
  }
</dl>
