---
import type { SiteLink } from "@gm/core";

interface Props {
  links: SiteLink[];
}

const { links } = Astro.props;
---

<footer class="border-t border-border">
  <nav aria-label="Footer" class="mx-auto flex max-w-[70ch] flex-wrap gap-x-6 gap-y-2 px-4 py-6 text-sm">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</footer>
