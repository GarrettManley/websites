---
import Mark from "@gm/ui/components/Mark.astro";
import BaseLayout from "@gm/ui/layouts/BaseLayout.astro";
import { footerLinks, nav, SITE_TITLE } from "../data/site";
import "../styles/theme.css";

interface Props {
  /** Page-specific title; omitted on the home page. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === undefined ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
/** The 404 page is served at many URLs, so it gets no canonical. */
const canonical = Astro.url.pathname.startsWith("/404")
  ? undefined
  : new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout title={fullTitle} description={description} nav={nav} footerLinks={footerLinks}>
  <link slot="head" rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {canonical && <link slot="head" rel="canonical" href={canonical} />}
  <a slot="brand" href="/" class="inline-flex min-h-6 items-center gap-3 text-fg no-underline">
    <Mark height={24} label="" />
    <span class="font-mono text-[13px] font-medium tracking-[0.18em]">GARRETT MANLEY</span>
  </a>
  <slot />
</BaseLayout>
