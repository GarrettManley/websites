{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!test-results",
      "!playwright-report",
      "!.wrangler"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
